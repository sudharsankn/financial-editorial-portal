# Supabase Database Configuration
# Get these from your Supabase Project Settings -> API
# Works for Next.js App Router (NEXT_PUBLIC_*) and Vite (VITE_*)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional: Service Role Key for backend administrative operations / seed scripts
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vercel Deployment & AI Studio Configuration
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Razorpay Payment Gateway Credentials (Test or Production)
VITE_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
